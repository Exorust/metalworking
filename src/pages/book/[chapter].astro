---
import Base from "../../layouts/Base.astro";
import { BOOK, BOOK_ORDER, firstProse } from "../../manifest.mjs";
import { render } from "../../markdown.mjs";
import { bookMd } from "../../content.mjs";

export function getStaticPaths() {
  return BOOK.flatMap((p) =>
    p.chapters.map(([file, title]) => ({
      params: { chapter: file },
      props: { file, title, part: p },
    })),
  );
}

const { file, title, part } = Astro.props;
const route = `/book/${file}/`;
const md = bookMd(file) ?? `# ${title}\n\nThis chapter is not written yet.\n`;
const i = BOOK_ORDER.findIndex((o) => o.route === route);
let html = `<div class="kicker">Chapter ${Number(file.slice(0, 2))} · Part ${part.n}: ${part.title}</div>` + render(md, "book");
// The answers stay covered until the reader hovers over or taps one. Each answer gets a
// tabindex so a tap (focus) reveals it on touch screens, where there is no hover.
html = html.replace(/(<h3>Answers<\/h3>\s*)<ol>([\s\S]*?)<\/ol>/, (m, h3, items) =>
  `${h3}<p class="answers-hint">Hover over or tap an answer to reveal it.</p><ol class="answers">` +
  items.replace(/<li>/g, '<li tabindex="0">') + "</ol>");
const desc = firstProse(md).slice(0, 300);
---

<Base route={route} title={title} desc={desc} form="book" src={`book/${file}.md`}
      prev={BOOK_ORDER[i - 1] ?? null} next={BOOK_ORDER[i + 1] ?? null}>
  <Fragment set:html={html} />
</Base>

<style is:global>
  .answers-hint { color: var(--muted); font-size: 0.85rem; margin: -0.6rem 0 0.6rem; }
  .answers li { filter: blur(7px); cursor: pointer; user-select: none; transition: filter 0.15s; outline: none; }
  .answers li:hover, .answers li:focus { filter: none; user-select: text; cursor: text; }
</style>
