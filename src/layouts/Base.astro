---
import { SECTIONS, BOOK, REPO, SITE, DEFAULT_DESC } from "../manifest.mjs";
import { MARK, pixelArrow } from "../pixel.mjs";
import { STYLE_URL, APP_URL } from "../assets.mjs";

// form: "book" | "glossary" | "home". src: repo path for the edit link.
const { route, title, desc = "", prev = null, next = null, form = "home", src = "README.md" } = Astro.props;

const crumb = route === "/" ? "/readme" : route.replace(/\/$/, "");
const pageTitle = route === "/" ? "metalworking — Apple Metal GPU performance" : title + " — metalworking";
const description = desc || DEFAULT_DESC;

function item(r, label, extra, activeRoute) {
  const cls = r === activeRoute ? ' class="active" aria-current="page"' : "";
  return `<li><a href="${r}"${cls}>${extra}${label}</a></li>`;
}
function section(key, heading, items) {
  return `<div class="toc-section" data-sec="${key}"><div class="toc-head"><span>${heading}</span><button class="fold" aria-label="${heading}" aria-expanded="true">&minus;</button></div><ul>${items}</ul></div>`;
}
// The index link sits directly under the drawer title, without a section heading of its own.
function plain(items) {
  return `<div class="toc-section"><ul>${items}</ul></div>`;
}
function glossarySidebar(activeRoute) {
  const head = plain(item("/glossary/", "All entries", "", activeRoute));
  return head + SECTIONS.map((s) =>
    section(s.dir, s.title, s.pages.map(([slug, t, chip]) =>
      item(`/glossary/${s.dir}/${slug}/`, t + (chip ? ` <span class="chip">${chip}</span>` : ""), "", activeRoute)).join(""))
  ).join("");
}
function bookSidebar(activeRoute) {
  const head = plain(item("/book/", "Contents", '<span class="num"></span>', activeRoute));
  return head + BOOK.map((p) =>
    section(`part-${p.n}`, `Part ${p.n}. ${p.title}`, p.chapters.map(([file, t]) =>
      item(`/book/${file}/`, t, `<span class="num">${file.slice(0, 2)}</span>`, activeRoute)).join(""))
  ).join("");
}
const toc = form === "glossary" ? glossarySidebar(route) : bookSidebar(route);
const arrow = pixelArrow();
// The wordmark's pixel "M" is decoration next to the word, so it is hidden from assistive tech.
const mark = MARK.replace('role="img" aria-label="M"', 'aria-hidden="true"');
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={SITE + route} />
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/azeret-mono-latin-400-normal.woff2" />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={SITE + route} />
<meta property="og:image" content={SITE + "/assets/banner.png"} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="stylesheet" href={STYLE_URL} />
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem("mw-theme")||"light"}catch(e){}</script>
</head>
<body data-prev={prev ? prev.route : ""} data-next={next ? next.route : ""}>
<a class="skip" href="#main">Skip to content</a>
<div class="frame">
<header class="top">
  <button class="burger" aria-label="Open navigation" aria-expanded="false" aria-controls="toc">&#9776;</button>
  <a class="wordmark" href="/" aria-label="metalworking, home"><Fragment set:html={mark} /><span class="wordmark-text">metalworking</span></a>
  <nav class="forms" aria-label="Book or glossary">
    <a href="/book/" class={form === "book" ? "on" : ""} aria-current={form === "book" ? "true" : undefined}>Book</a>
    <a href="/glossary/" class={form === "glossary" ? "on" : ""} aria-current={form === "glossary" ? "true" : undefined}>Glossary</a>
  </nav>
  <div class="themes">
    <button class="theme-btn" id="theme-open" aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-list">
      <span class="visually-hidden">Color theme: </span><span id="theme-current"></span><span class="caret" aria-hidden="true">&#9662;</span>
    </button>
    <div class="theme-list" id="theme-list" role="listbox" aria-label="Color theme" hidden>
      <button role="option" data-theme="terminal" aria-selected="false">Terminal</button>
      <button role="option" data-theme="green" aria-selected="false">Light green</button>
      <button role="option" data-theme="light" aria-selected="false">Light</button>
      <button role="option" data-theme="violet" aria-selected="false">Violet Midnight</button>
    </div>
  </div>
  <button class="searchbox" id="search-open"><svg class="mag" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10" y1="10" x2="14" y2="14" stroke="currentColor" stroke-width="1.6"/></svg> Search <kbd id="search-kbd">&#8984;K</kbd></button>
  <a class="gh-btn" href={REPO} target="_blank" rel="noopener">GitHub <span class="ext ext-px" aria-hidden="true"><Fragment set:html={arrow} /></span><span class="visually-hidden"> (opens in a new tab)</span></a>
</header>
<div class="body">
<div class="backdrop" id="nav-backdrop" hidden></div>
<aside class="toc" id="toc" tabindex="-1"><div class="toc-bar"><div class="toc-title">{form === "glossary" ? "GLOSSARY" : "THE BOOK"}</div><button class="toc-close" aria-label="Close navigation">&times;</button></div><div class="toc-tools" id="toc-tools"></div><Fragment set:html={toc} /></aside>
<main class="content" id="main" tabindex="-1">
  <div class="crumb">{crumb}</div>
  <slot />
  <div class="pagenav">
    {prev
      ? <a class="pager prev" href={prev.route}><span class="pager-kicker"><Fragment set:html={arrow} /> Previous</span><span class="pager-title">{prev.title}</span></a>
      : <span class="pager-empty"></span>}
    {next
      ? <a class="pager next" href={next.route}><span class="pager-kicker">Next <Fragment set:html={arrow} /></span><span class="pager-title">{next.title}</span></a>
      : <span class="pager-empty"></span>}
  </div>
  <div class="pagefoot"><a href={`${REPO}/blob/main/${src}`} target="_blank" rel="noopener">Edit this page on GitHub <span class="ext" aria-hidden="true">&#8599;</span><span class="visually-hidden"> (opens in a new tab)</span></a></div>
</main>
</div>
</div>
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-row">
      <input id="search-input" type="search" placeholder="Search the book and the glossary..." autocomplete="off"
             aria-label="Search the book and the glossary" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
      <button class="search-close" id="search-close" aria-label="Close search">&times;</button>
    </div>
    <div id="search-status" class="visually-hidden" aria-live="polite"></div>
    <ul id="search-results" role="listbox" aria-label="Search results"></ul>
    <div class="search-hint"><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate &nbsp; <kbd>&crarr;</kbd> open &nbsp; <kbd>esc</kbd> close</div>
  </div>
</div>
<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged diagram">
  <div class="lightbox-bar"><button class="lightbox-close" aria-label="Close enlarged diagram">Close &times;</button></div>
  <div class="lightbox-body"></div>
</div>
<script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script is:inline src={APP_URL}></script>
</body>
</html>
